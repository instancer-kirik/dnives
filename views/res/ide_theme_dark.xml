<?xml version="1.0" encoding="utf-8"?>
<theme id="ide_theme_dark" parent="theme_dark"
        fontFace="Segoe UI,Ubuntu,Cantarell,Verdana,Arial,DejaVu Sans"
        fontFamily="SansSerif"
        textColor="#CDD6F4"
        >

    <!--
        Dnives Dark Theme — Catppuccin Mocha inspired
        Base palette:
          Mantle  #181825  (panels/sidebars)
          Base    #1E1E2E  (editor background)
          Surface #313244  (hover/selection)
          Overlay #45475A  (borders/muted)
          Text    #CDD6F4  (primary text)
          Subtext #A6ADC8  (secondary text)
          Blue    #89B4FA
          Mauve   #CBA6F7
          Green   #A6E3A1
          Yellow  #F9E2AF
          Peach   #FAB387
          Red     #F38BA8
          Pink    #EBA0AC
          Teal    #94E2D5
    -->

    <!-- ── Editor ─────────────────────────────────────────────── -->
    <color id="edit_background"                  value="#1E1E2E"/>

    <!-- ── Links ─────────────────────────────────────────────── -->
    <color id="link_color"                       value="#89B4FA"/>

    <!-- ── Syntax Highlighting ───────────────────────────────── -->
    <color id="syntax_highlight_comment"         value="#6272A4"/>
    <color id="syntax_highlight_comment_documentation" value="#A6E3A1"/>
    <color id="syntax_highlight_keyword"         value="#CBA6F7"/>
    <color id="syntax_highlight_string"          value="#F9E2AF"/>
    <color id="syntax_highlight_character"       value="#F9E2AF"/>
    <color id="syntax_highlight_integer"         value="#FAB387"/>
    <color id="syntax_highlight_float"           value="#FAB387"/>
    <color id="syntax_highlight_ident"           value="#CDD6F4"/>
    <color id="syntax_highlight_error"           value="#F38BA8"/>

    <!-- ── Build Log ─────────────────────────────────────────── -->
    <color id="build_log_filename_color"         value="#89B4FA"/>
    <color id="build_log_error_color"            value="#F38BA8"/>
    <color id="build_log_warning_color"          value="#F9E2AF"/>
    <color id="build_log_deprecation_color"      value="#EBA0AC"/>

    <!-- ── Checkboxes ────────────────────────────────────────── -->
    <drawable id="btn_check" value="btn_check_dark"/>

    <!-- ── Home Screen ───────────────────────────────────────── -->
    <style id="HOME_SCREEN_TITLE"
        fontSize="160%"
        textColor="#89B4FA"
    />

    <style id="HOME_SCREEN_TITLE2"
        fontSize="120%"
        textColor="#A6ADC8"
    />

    <style id="HOME_SCREEN_SECTION"
        fontSize="110%"
        textColor="#94E2D5"
    />

    <style id="HOME_SCREEN_HINT"
        fontSize="90%"
        textColor="#585B70"
    />

    <!-- ── Terminal ──────────────────────────────────────────── -->
    <style id="TERMINAL"
        backgroundColor="#1E1E2E"
        textColor="#CDD6F4"
        fontFace="DejaVu Sans Mono,Monospace,Courier New"
        fontFamily="Monospace"
        fontSize="14"
    />

</theme>
